rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminEmail() {
      return isSignedIn() && request.auth.token.email in ['lucy2511kh@gmail.com', 'le.ntmkh@gmail.com'];
    }

    function isParticipant(room) {
      return isSignedIn() && (
        room.hostId == request.auth.uid ||
        room.captainId == request.auth.uid ||
        room.crewId == request.auth.uid
      );
    }

    function isClaimingCaptain(room) {
      return room.status == 'waiting'
        && room.captainId == null
        && request.resource.data.hostId == room.hostId
        && request.resource.data.status == room.status
        && request.resource.data.captainId == request.auth.uid
        && request.resource.data.crewId == room.crewId;
    }

    function isClaimingCrew(room) {
      return room.status == 'waiting'
        && room.crewId == null
        && request.resource.data.hostId == room.hostId
        && request.resource.data.status == room.status
        && request.resource.data.crewId == request.auth.uid
        && request.resource.data.captainId == room.captainId;
    }

    match /admin_runtime_config/{docId} {
      allow read, write: if isAdminEmail();
    }

    match /rooms/{roomId} {
      // Host creates the room.
      allow create: if isSignedIn() && request.resource.data.hostId == request.auth.uid;

      // IMPORTANT:
      // - Allow opening a *waiting* room by link (GET) so a new player can claim a role.
      // - Do NOT allow listing all rooms publicly.
      allow get: if isSignedIn() && (isParticipant(resource.data) || resource.data.status == 'waiting');
      allow list: if false;

      // Participants can update.
      // Non-participants can only claim Captain/Crew once while room is waiting.
      allow update: if isParticipant(resource.data) || (isSignedIn() && (isClaimingCaptain(resource.data) || isClaimingCrew(resource.data)));

      allow delete: if false;

      match /rounds/{roundId} {
        // Only participants can access rounds.
        allow create, get, list, update: if isParticipant(get(/databases/$(database)/documents/rooms/$(roomId)).data);
        allow delete: if false;
      }
    }

    // Keep THC collections (optional)
    match /game_settings/{docId} {
      allow read, write: if true;
    }

    match /rounds/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
